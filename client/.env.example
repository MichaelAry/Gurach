# ──────────────────────────────────────────────────────────────────────
# Client (Next.js). Скопируйте в client/.env.local и поменяйте значения.
#
# Используются только на серверной стороне Next: server components
# (features/tracks/api/*) и route handlers (app/api/*). Браузер ходит
# в Nest через прокси /api/*, поэтому NEXT_PUBLIC_* не нужны.
# ──────────────────────────────────────────────────────────────────────

# Адрес Nest-бэкенда без хвостового слэша.
# Если переменная не задана, для локальной разработки берётся
# http://localhost:5000. В production API_URL обязателен и для `next build`,
# и для `next start` — иначе сборка упадёт с понятной ошибкой
# (иначе пререндеренные страницы «запекли» бы localhost-ссылки).
API_URL=http://localhost:5000

# Shared with server/.env CACHE_EVENT_SECRET; keep private and generate 32+ URL-safe random characters.
# CACHE_EVENT_SECRET=

# Exact browser origin, required in production; no trailing slash.
APP_ORIGIN=http://localhost:3000
