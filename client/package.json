{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:generate": "openapi-typescript ../server/openapi.json --output lib/api/schema.d.ts",
    "api:check": "node scripts/check-api-contracts.mjs",
