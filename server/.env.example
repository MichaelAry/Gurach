# ──────────────────────────────────────────────────────────────────────
# Server (NestJS). Скопируйте в server/.env и поменяйте значения.
# Если .env нет, env.ts использует локальные defaults. Для рекомендуемой
# replica set базы запустите `node scripts/dev-db.mjs up`, затем задайте
# MONGODB_URI значением из игнорируемого .local/mongo/app.env. Это отдельный
# app user, не bootstrap root из .local/mongo/dev.env.
# ──────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Интерфейс и порт, которые слушает Nest.
# В production HOST по умолчанию 0.0.0.0, в development — localhost.
HOST=localhost
PORT=5000

# Публичный адрес API. Из него собираются абсолютные URL обложек и аудио
# (PUBLIC_URL/static/...). В production обязателен.
PUBLIC_URL=http://localhost:5000

# Whitelist браузерных запросов через запятую (CORS).
CORS_ORIGINS=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────────────────
# Вариант 1: полная строка подключения (приоритетный).
# MONGODB_URI=mongodb://gurach_app:<private-password>@127.0.0.1:27028/gurach?authSource=gurach&replicaSet=rs0&directConnection=true

# Legacy вариант (если MONGODB_URI не задан): URI собирается
# из частей. Без логина/пароля подойдёт обычный локальный mongod.
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_DATABASE=nest
# Логин/пароль указывайте СЫРЫМИ (без URL-энкодинга) — сервер закодирует сам.
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=admin

# ── Файлы ──────────────────────────────────────────────────────────────
# Каталог статики (audio/, picture/). Относительный путь считается от server/.
STATIC_DIR=static
# Private upload staging outside STATIC_DIR. The directory is owner-only and is never served over HTTP.
MEDIA_STAGING_DIR=.local/media-staging
# Requires the FFmpeg package (ffprobe executable); set an absolute path when it is not on PATH.
FFPROBE_PATH=ffprobe

# Максимальный размер одного загружаемого файла, МБ.
UPLOAD_MAX_MB=50

# ── Rate limit ─────────────────────────────────────────────────────────
# Окно в миллисекундах, общий лимит запросов на IP и отдельный лимит
# для POST /tracks/:id/listen.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_LISTEN_LIMIT=10

# Durable media cleanup worker polling interval in milliseconds (default 5000).
MAINTENANCE_POLL_INTERVAL_MS=5000

# Fixed Next.js cache-event endpoint and a shared random secret (32+ characters).
# Configure the same secret in client/.env.local. Keep both values private.
# CACHE_EVENT_URL=http://localhost:3000/api/internal/cache-events
# CACHE_EVENT_SECRET=
